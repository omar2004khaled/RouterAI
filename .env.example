GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
# Use a long random value in production; this signs the session cookie.
SESSION_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173

# Sentry error tracking — get your DSN from https://sentry.io
# Leave blank to disable Sentry (pipeline still works without it).
SENTRY_DSN=

# Set to true ONLY in local development to enable the /api/debug/sentry-test endpoint.
# Never set this to true in production.
DEBUG_MODE=false
